---
// The website's one page (docs/rfc/website-redesign.md, concept 1i). It links to the guide on GitHub. Its anchors
// (#privacy, #features, #problem, #how, #languages, #quickstart, #faq) keep the old page's links working.
import Base from "../layouts/Base.astro";
import Nav from "../components/site/Nav.astro";
import Footer from "../components/site/Footer.astro";
import Hero from "../components/site/Hero.astro";
import Statement from "../components/site/Statement.astro";
import Features from "../components/site/Features.astro";
import Centre from "../components/site/Centre.astro";
import Story from "../components/site/Story.astro";
import Languages from "../components/site/Languages.astro";
import Quickstart from "../components/site/Quickstart.astro";
import Faq from "../components/site/Faq.astro";
---

<Base>
  <Nav />
  <main id="main" tabindex="-1">
    <Hero />

    <Statement />
    <Features />
    <Centre />

    <Story />

    <Languages />
    <Quickstart />
    <Faq />
  </main>
  <Footer />
</Base>
