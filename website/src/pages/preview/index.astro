---
// The redesigned homepage (docs/rfc/website-redesign.md, concept 1i), built here at a hidden /preview/ (noindex,
// out of the sitemap) until it replaces the homepage in part 6. Part 1 built the shell with each section as a plain
// placeholder holding today's copy; parts 2 to 5 swap them for the real sections (part 2: the hero; part 4: the
// statement, cards, Insights and centre line; part 5: the story; part 5b: languages, quick start and FAQ). The
// anchors match today's page.
import Base from "../../layouts/Base.astro";
import Nav from "../../components/site/Nav.astro";
import Footer from "../../components/site/Footer.astro";
import Hero from "../../components/site/Hero.astro";
import Statement from "../../components/site/Statement.astro";
import Features from "../../components/site/Features.astro";
import Centre from "../../components/site/Centre.astro";
import Story from "../../components/site/Story.astro";
import Languages from "../../components/site/Languages.astro";
import Quickstart from "../../components/site/Quickstart.astro";
import Faq from "../../components/site/Faq.astro";
---

<Base noindex>
  <Nav />
  <main id="main" tabindex="-1">
    <Hero />

    <Statement />
    <Features />
    <Centre />

    <Story />

    <Languages />
    <Quickstart />
    <Faq />
  </main>
  <Footer />
</Base>
