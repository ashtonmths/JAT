---
// The landing page's shell: the head (SiteHead: what search engines and link previews read), the
// fonts, the background, and the motion script.
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/instrument-serif/400-italic.css";
import "../styles/landing.css";
import SiteHead from "../components/SiteHead.astro";
---

<!doctype html>
<html lang="en" data-palette="paper">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    {
      /* Dev server only (`pnpm dev`): ?palette=paper, forest, ember or indigo previews another
         colour scheme. The published site is always paper. */
      import.meta.env.DEV && <script is:inline>
        const palette = new URLSearchParams(location.search).get("palette");
        if (palette) document.documentElement.dataset.palette = palette;
      </script>
    }
    <SiteHead />
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <div class="backdrop" aria-hidden="true">
      <div class="aurora a1"></div>
      <div class="aurora a2"></div>
      <div class="aurora a3"></div>
      <div class="grid"></div>
      <div class="noise"></div>
    </div>
    <slot />
    <p class="sr-only" aria-live="polite" id="announce"></p>
    {import.meta.env.DEV && (
      <div class="palette-switch" aria-label="Preview a colour scheme (dev only)">
        {["indigo", "paper", "forest", "ember"].map((p) => (
          <a href={`?palette=${p}`}>{p}</a>
        ))}
      </div>
    )}
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
