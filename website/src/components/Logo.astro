---
// The app's logo (frontend/public/favicon.svg), inline so it can glow.
interface Props {
  size?: number;
  // The gradient's id, unique per logo on a page.
  id?: string;
}
const { size = 28, id = "logo-g" } = Astro.props;
---

<svg
  class="logo"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
>
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color: var(--brand)"></stop>
      <stop offset="1" style="stop-color: var(--violet)"></stop>
    </linearGradient>
  </defs>
  <rect width="24" height="24" rx="6" fill={`url(#${id})`}></rect>
  <g
    fill="none"
    style="stroke: var(--on-brand)"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="8"></circle>
    <circle cx="12" cy="12" r="4.5"></circle>
    <circle cx="12" cy="12" r="1"></circle>
  </g>
</svg>

<style>
  .logo {
    flex: none;
    filter: drop-shadow(0 0 12px color-mix(in oklab, var(--brand) 60%, transparent));
  }
</style>
