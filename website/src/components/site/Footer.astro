---
// The closing panel: a rounded plum panel inset from the page edges, with the links and small print of
// today's footer.
import Logo from "../Logo.astro";
import { GUIDE, REPO } from "../../data";

const year = new Date().getFullYear();
const columns = [
  {
    title: "Product",
    links: [
      { href: "#features", label: "Features" },
      { href: "#how", label: "How it works" },
      { href: "#quickstart", label: "Quick start" },
      { href: "#faq", label: "FAQ" },
    ],
  },
  {
    title: "Docs",
    links: [
      { href: `${GUIDE}install.md`, label: "Install" },
      { href: `${GUIDE}your-data.md`, label: "Your data" },
      { href: `${GUIDE}using-the-app.md`, label: "Using the app" },
      { href: `${GUIDE}commands.md`, label: "Commands" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: REPO, label: "GitHub" },
      { href: `${REPO}/issues`, label: "Issues" },
      { href: `${REPO}/blob/main/CONTRIBUTING.md`, label: "Contributing" },
      { href: `${REPO}/blob/main/CHANGELOG.md`, label: "Changelog" },
    ],
  },
];
---

<footer class="foot" data-tint="apricot">
  <div class="panel">
    <div class="big">
      <p class="eyebrow">
        <Logo size={18} id="logo-foot" /> Job Application Tracker
      </p>
      <p class="line">Your search, on your machine.</p>
      <a class="pill get" href={`${GUIDE}install.md`}>
        Get started{" "}
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </a>
    </div>
    <nav class="cols" aria-label="Footer">
      {columns.map((c) => (
        <div>
          <h2>{c.title}</h2>
          {c.links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </div>
      ))}
    </nav>
    <p class="legal">
      <span>
        © {year} Kai Waddington · <a href={`${REPO}/blob/main/LICENSE`}>Apache-2.0</a>
      </span>
      <span>
        Screenshots show made-up demo data. Hosted on GitHub Pages; this site adds no cookies, analytics or
        trackers.
      </span>
    </p>
  </div>
</footer>

<style>
  .foot {
    padding: var(--gutter);
  }
  .panel {
    border-radius: var(--r-panel);
    background: var(--plum);
    color: var(--on-plum);
    --focus: var(--focus-on-dark);
    padding: clamp(36px, 5vw, 72px);
    padding-bottom: 96px;
    display: grid;
    grid-template-columns: 1.3fr 2fr;
    gap: 48px;
  }
  .eyebrow {
    color: var(--on-plum-soft);
  }
  .eyebrow::before {
    display: none;
  }
  .line {
    margin: 0 0 28px;
    font-weight: 300;
    font-size: clamp(30px, 3vw, 44px);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .get {
    color: var(--plum);
    background: linear-gradient(180deg, #fff, var(--pastel-lilac));
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    font-size: 14px;
  }
  .cols div {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cols h2 {
    margin: 0 0 6px;
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-plum-soft);
  }
  .cols a {
    text-decoration: none;
    color: rgb(247 245 252 / 0.85);
  }
  .cols a:hover {
    color: #fff;
  }
  .legal {
    grid-column: 1 / -1;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    font-size: 12.5px;
    color: rgb(247 245 252 / 0.5);
  }
  @media (max-width: 760px) {
    .panel {
      grid-template-columns: 1fr;
      border-radius: 26px;
    }
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
