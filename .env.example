# Copy to .env (git-ignored) and adjust. Never commit your real .env.

# Where your job-search data lives: a directory OUTSIDE this repo, ideally a private git repo.
JAT_DATA_DIR=~/job-search-data

# Web app address (localhost only by default).
# JAT_HOST=127.0.0.1
# JAT_PORT=8770

# Windows only, and only on a test data folder: turns git snapshots back on there. They're off
# on Windows for now, and with this on nothing stops the app and `jat snapshot` committing at once.
# JAT_WINDOWS_SNAPSHOTS=1
