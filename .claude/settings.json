{
  "permissions": {
    "allow": [
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/dev/after_compact.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
